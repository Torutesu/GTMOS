# --- Superdemovideo (M1) ---------------------------------------------------
# All values are optional. With none set, everything runs locally in mock mode.

# LLM: "mock" (deterministic, no network, no key) | "live" (Anthropic API)
SDV_LLM_MODE=mock
# Required only when SDV_LLM_MODE=live
ANTHROPIC_API_KEY=

# API bearer token. Unset => auth is skipped (dev mode).
SDV_TOKEN=

# HTTP port for the API + web UI
SDV_PORT=3000

# Data root. Everything the app writes lives under here.
SDV_VAR_DIR=./var

# Storage driver: "fs" (default) | "s3"
SDV_STORAGE_DRIVER=fs
# S3 driver only
SDV_S3_BUCKET=
SDV_S3_REGION=

# Sandbox driver: "local" (default, subprocess) | "docker" (not implemented in M1)
SDV_SANDBOX_DRIVER=local

# Postgres. Unset => embedded PGlite under $SDV_VAR_DIR/db
DATABASE_URL=

# Chromium for capture. Defaults to the preinstalled browser when present.
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
# SDV_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
